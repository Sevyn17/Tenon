{
  "name": "@tenon/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tenon 的前端：L0 协议客户端、L1 hooks、L2 组件、L3 工作台。产品在自己的前端入口里 createShell({brand, contributions})。",
  "exports": {
    "./client": "./src/client/index.ts",
    "./client/react": "./src/client/react/index.ts",
    "./ui": "./src/ui/index.ts",
    "./shell": "./src/shell/index.tsx",
    "./shell/embed": "./src/shell/embed.tsx"
  },
  "scripts": {
    "dev": "vite",
    "deps": "node scripts/check-deps.mjs",
    "typecheck": "node scripts/check-deps.mjs && tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/check-deps.mjs && tsc --noEmit && vite build"
  },
  "dependencies": {
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
