              ]
            }
          },
          {
            "Name": "shell",
            "Description": "<shell-intro>返回合并的 stdout/stderr 与退出码。每次调用是新进程，已在工作目录执行（不必先 cd），cd 与环境变量不保留。timeout 秒（默认 120，最大 600），超时杀整个进程树。长时间运行（服务、监听）用 background:true，返回 job id，再用 job_output 读取输出、job_kill 终止。",
            "Schema": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "timeout": {
                  "type": "integer",
                  "description": "超时秒数"
                },
                "background": {
                  "type": "boolean",
                  "description": "后台运行，立即返回 job id"
                },
                "sandbox_permissions": {
                  "type": "string",
                  "enum": [
                    "read-only",
                    "workspace-write",
                    "danger-full-access"
                  ],
                  "description": "仅在命令被沙箱拒绝后使用：为本次调用申请更宽的沙箱，需要用户批准"
                }
              },
              "required": [
                "command"
              ]
            }
          },
          {
            "Name": "job_output",
            "Description": "读取后台 job 自上次读取以来的新输出与状态。wait:true 时等到 job 结束或 timeout 秒（默认 30）。",
            "Schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "wait": {
                  "type": "boolean"
                },
                "timeout": {
                  "type": "integer"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          {
            "Name": "job_kill",
            "Description": "终止一个后台 job（连同其子进程）。",
            "Schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          {
            "Name": "subagent",
            "Description": "把一个独立、边界清楚的子任务委派给子智能体（全新上下文，同样的工具）。task 要自包含：子智能体看不到当前对话。返回子智能体的最终回答与子会话 id；传 session 可继续同一个子会话追问。",
            "Schema": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "description": "自包含的任务说明"
                },
                "session": {
                  "type": "string",
                  "description": "可选：续用的子会话 id"
                },
                "agent": {
                  "type": "string",
                  "description": "可选：子智能体用的定义名；只能选本会话定义 [use.subagent] agents 里列出的，缺省为通用子智能体"
                }
              },
              "required": [
                "task"
              ]
            }
          },
          {
            "Name": "team_spawn",
            "Description": "派一个工作组成员（独立会话、同样的基础工具 + 看板）去做自包含的任务，立即返回，不等结果。成员做完时它的最终回答会作为一条新消息送回给你。同名成员已存在则把 task 作为下一条消息发给它。",
            "Schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "成员名，小写字母数字和连字符"
                },
                "task": {
                  "type": "string",
                  "description": "自包含的任务说明"
                }
              },
              "required": [
                "name",
                "task"
              ]
            }
          },
          {
            "Name": "team_send",
            "Description": "给工作组里的另一位发消息：to 为 \"lead\"（领导）或成员名。消息进入对方 inbox，对方空闲时立即处理。",
            "Schema": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "to",
                "message"
              ]
            }
          },
          {
            "Name": "team_stop",
            "Description": "中止一个正在工作的成员的当前任务（会话保留，之后可用 team_send 让它继续）。",
            "Schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "成员名"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          {
            "Name": "task_create",
            "Description": "在工作组看板上新建任务（pending、无负责人）。",
            "Schema": {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "subject"
              ]
            }
          },
          {
            "Name": "task_list",
            "Description": "列出工作组看板上的全部任务（id、状态、负责人、结果）。",
            "Schema": {
              "type": "object",
              "properties": {}
            }
          },
          {
            "Name": "task_claim",
            "Description": "领取一个 pending 任务（成为负责人，状态改为 in_progress）。",
            "Schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                }
              },
              "required": [
                "id"
              ]
            }
          },
          {
            "Name": "task_complete",
            "Description": "把自己负责的任务标为完成，附一句结果。",
            "Schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "result": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            }
          }
        ],
        "Params": {
          "Temperature": null,
          "MaxTokens": null,
          "ToolChoice": null,
          "Reasoning": null,
          "Extra": null
        }
