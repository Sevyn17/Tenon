                "kind": "text",
                "text": "请派成员"
              }
            ],
            "ToolCalls": null,
            "ToolCallID": ""
          },
          {
            "Role": "assistant",
            "Content": null,
            "ToolCalls": [
              {
                "ID": "id1",
