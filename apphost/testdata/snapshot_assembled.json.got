                  "type": "string",
                  "description": "文件过滤，如 *.go 或 **/*_test.go"
                },
                "ignore_case": {
                  "type": "boolean"
                },
                "literal": {
                  "type": "boolean",
                  "description": "把 pattern 当字面量"
                },
                "context": {
                  "type": "integer",
                  "description": "匹配前后各显示几行"
                },
                "limit": {
                  "type": "integer",
                  "description": "最多返回的匹配数"
                }
              },
              "required": [
                "pattern"
              ]
            }
          },
          {
            "Name": "glob",
